variable "role_name" {
  description = "Name of the discovery role in the customer account (template parameter TrustingAccountRoleName). Max 64 characters."
  type        = string

  validation {
    condition     = can(regex("^[A-Za-z0-9+=,.@_-]{1,64}$", var.role_name))
    error_message = "role_name must be 1-64 characters of [A-Za-z0-9+=,.@_-]."
  }
}

variable "trusted_role_arn" {
  description = "ARN of Zscaler's discovery role that may assume this role (template parameter ZscalerTrustedRole)."
  type        = string

  validation {
    condition     = can(regex("^arn:aws[a-z-]*:iam::[0-9]{12}:role/.+$", var.trusted_role_arn))
    error_message = "trusted_role_arn must be an IAM role ARN."
  }
}

variable "external_id" {
  description = "External ID required in the trust policy (template parameter ExternalId), generated by Zscaler when the account is registered."
  type        = string

  validation {
    condition     = can(regex("^[a-zA-Z0-9-]+$", var.external_id))
    error_message = "external_id must match ^[a-zA-Z0-9-]+$ (as in the Zscaler template)."
  }
}

variable "tags" {
  description = "Tags applied to the role."
  type        = map(string)
  default     = {}
}
