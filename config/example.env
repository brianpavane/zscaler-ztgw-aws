# -----------------------------------------------------------------------------
# Tenant/environment credentials for scripts/run.sh
#
#   cp config/example.env config/zs2.env && chmod 600 config/zs2.env
#
# The file name (without .env) is the <env> argument to run.sh and also the
# Terraform workspace and tfvars name (stacks/<stack>/env/<env>.tfvars).
# Real config/*.env files are git-ignored. run.sh refuses files that are
# readable by group/other.
#
# Format: KEY=VALUE, one per line. The file is parsed, NOT sourced: no shell
# expansion, no `export`, no command substitution. Optional surrounding
# single or double quotes are stripped.
# -----------------------------------------------------------------------------

# Authentication framework: oneapi | legacy
ZSCALER_AUTH_MODE=oneapi

# --- OneAPI (ZIdentity OAuth2 client credentials) ----------------------------
# Production ZS2 / ZS3 tenants: leave ZSCALER_CLOUD empty (OneAPI resolves the
# tenant from the vanity domain). Only set it for beta/gov.
ZSCALER_CLIENT_ID=
ZSCALER_CLIENT_SECRET=
# ZSCALER_PRIVATE_KEY=          # alternative to ZSCALER_CLIENT_SECRET
ZSCALER_VANITY_DOMAIN=
ZSCALER_CLOUD=

# --- Legacy API ---------------------------------------------------------------
# Cloud names: zscalertwo (ZS2) | zscalerthree (ZS3)
ZIA_USERNAME=
ZIA_PASSWORD=
ZIA_API_KEY=
ZIA_CLOUD=zscalertwo

# Cloud & Branch Connector (ZTC) legacy admin - used from Phase 2 onward.
ZTC_USERNAME=
ZTC_PASSWORD=
ZTC_API_KEY=
ZTC_CLOUD=zscalertwo

# --- AWS (Phase 3) ------------------------------------------------------------
# Standard AWS SDK variables; use a named profile rather than static keys.
# Direct mode: a profile for the customer account. Assume-role mode: a profile
# for your central account (set aws_assume_role_arn in the stack's tfvars).
AWS_PROFILE=
AWS_REGION=us-west-2
